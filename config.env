# =========================================================
# Kolla-Ansible All-in-One 자동 구축 설정 파일
# 서버 환경에 맞게 이 파일만 수정하면 됨
# =========================================================

# --- NIC (직접 netplan 설정 완료 후 이름만 적기) ---
# 관리망 인터페이스 (IP 있어야 함. ex: 10.0.0.11/24)
NETWORK_INTERFACE="ens33"
# Neutron external 인터페이스 (IP 없어야 함)
NEUTRON_EXTERNAL_INTERFACE="ens37"

# --- OpenStack 내부 VIP (관리망 대역의 비어있는 IP) ---
KOLLA_INTERNAL_VIP="10.0.0.50"

# --- Kolla 설정 ---
KOLLA_BASE_DISTRO="ubuntu"
ENABLE_HORIZON="yes"
ENABLE_CINDER="no"
# kolla-ansible 설치 브랜치 (master 또는 stable/2025.1 등)
KOLLA_ANSIBLE_BRANCH="master"

# --- 경로 ---
VENV_DIR="${HOME}/kolla-venv"
INVENTORY="${HOME}/all-in-one"

# =========================================================
# 아래는 03-resources.sh (실습 리소스 자동 생성)에서 사용
# =========================================================

# Provider(External) Network — ens37이 실제 연결된 대역
PROVIDER_CIDR="192.168.2.0/24"
PROVIDER_GATEWAY="192.168.2.1"
PROVIDER_POOL_START="192.168.2.200"
PROVIDER_POOL_END="192.168.2.250"
PROVIDER_DNS="8.8.4.4"
PROVIDER_PHYSNET="physnet1"

# Self-Service Network
SELFSERVICE_CIDR="172.16.1.0/24"
SELFSERVICE_GATEWAY="172.16.1.1"
SELFSERVICE_DNS="8.8.4.4"

# CirrOS 이미지
CIRROS_VERSION="0.6.3"
CIRROS_URL="https://download.cirros-cloud.net/${CIRROS_VERSION}/cirros-${CIRROS_VERSION}-x86_64-disk.img"
